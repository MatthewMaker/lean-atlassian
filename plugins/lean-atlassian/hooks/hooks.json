{
  "description": "Injects the user's Atlassian cloud_id/site_url into each session (and into the atlassian-researcher subagent) so /jira, /confluence, and the atlassian-mediation skill never need to look them up, and auto-approves the executeRead/executeWrite operations the user lists in their settings file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Aa]tlassian.*__execute(Read|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/approve-listed-operations.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "atlassian-researcher$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/load-atlassian-config.sh SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/load-atlassian-config.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
